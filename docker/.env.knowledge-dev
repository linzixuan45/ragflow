# Local development deployment for 企业知识库 v3.0.
# This file is intentionally ignored by Git together with docker/.env.

DOC_ENGINE=elasticsearch
DEVICE=gpu
COMPOSE_PROFILES=elasticsearch,gpu
COMPOSE_PROJECT_NAME=ragflow-knowledge-dev
RAGFLOW_IMAGE=docker.1panel.live/infiniflow/ragflow:v0.26.4

# Required while Compose parses the official service before this overlay removes
# every mapping except ragflow-gpu:9380.
SVR_WEB_HTTP_PORT=80
SVR_WEB_HTTPS_PORT=443
SVR_HTTP_PORT=9380
ADMIN_SVR_HTTP_PORT=9381
SVR_MCP_PORT=9382
GO_HTTP_PORT=9384
GO_ADMIN_PORT=9383

STACK_VERSION=8.11.3
MEM_LIMIT=8073741824
ELASTIC_PASSWORD=infini_rag_flow
ES_HOST=es01
ES_PORT=1200

MYSQL_PASSWORD=infini_rag_flow
MYSQL_HOST=mysql
MYSQL_DBNAME=rag_flow
MYSQL_PORT=3306
EXPOSE_MYSQL_PORT=3306
MYSQL_MAX_PACKET=1073741824

MINIO_HOST=minio
MINIO_USER=rag_flow
MINIO_PASSWORD=infini_rag_flow
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

REDIS_HOST=redis
REDIS_PASSWORD=infini_rag_flow
REDIS_PORT=6379

API_PROXY_SCHEME=python
ALLOW_ANY_HOST=0
DISABLE_PASSWORD_LOGIN=false
DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1
REGISTER_ENABLED=1
THREAD_POOL_MAX_WORKERS=128
USE_DOCLING=false
TZ=Asia/Shanghai
DOC_BULK_SIZE=4
EMBEDDING_BATCH_SIZE=16
